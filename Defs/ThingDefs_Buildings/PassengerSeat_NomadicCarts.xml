<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="VehicleSeatBase" MayRequire="OELS.VehicleMapFramework">
		<defName>NC_PassengerSeat</defName>
		<label>simple passenger seat</label>
		<description>Passenger seat tailored for carts.</description>
		<graphicData>
			<texPath>Things/BuildableUpgrade/VehicleSeat/PassengerSeat_Cart</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.3,1.3)</drawSize>
		</graphicData>
		<statBases>
			<Mass>5</Mass>
		</statBases>
		<size>(1,1)</size>
		<costList>
			<Cloth>100</Cloth>
		</costList>
		<researchPrerequisites Inherit="False">
			<li>N_Carts</li>
		</researchPrerequisites>
		<comps>
			<li Class = "VehicleMapFramework.CompProperties_BuildableUpgrades">
				<compClass>VehicleMapFramework.CompVehicleSeat</compClass>
				<upgrades>
					<li Class = "VehicleMapFramework.VehicleUpgradeBuildable">
						<roles>
							<li Class = "VehicleMapFramework.RoleUpgradeBuildable">
								<key>passenger</key>
								<editKey>passenger seat</editKey>
								<label>Passenger</label>
								<handlingTypes>None</handlingTypes>
								<slots>1</slots>
								<exposed>true</exposed>
								<pawnRenderer>
									<showBody>true</showBody>
									<drawOffsetNorth>(0,0,0.3)</drawOffsetNorth>
									<drawOffsetSouth>(0,0,0)</drawOffsetSouth>
									<drawOffsetEast>(0.2,0,0.15)</drawOffsetEast>
								</pawnRenderer>
							</li>
						</roles>
					</li>
				</upgrades>
			</li>
		</comps>
		<uiOrder>1022</uiOrder>
	</ThingDef>
</Defs>


