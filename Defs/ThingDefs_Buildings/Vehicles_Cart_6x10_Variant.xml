<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <Vehicles.VehicleBuildDef ParentName="VehicleWithMapBaseBuildable">
    <defName>N_Carts_Medium_Blueprint</defName>
    <label>Medium Cart</label>
    <designationCategory>VF_Vehicles</designationCategory>
    <graphicData>
      <texPath>Things/Vehicles/Cart_6x10_Variant/Cart_6x10_Variant</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(8, 14)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Flammability>0.05</Flammability>
    </statBases>
    <size>(8,14)</size>
    <researchPrerequisites>
      <li>N_Carts</li>
    </researchPrerequisites>
    <costList>
      <WoodLog>500</WoodLog>
      <Steel>200</Steel>
    </costList>
    <soundImpactDefault>BulletImpact_Wood</soundImpactDefault>
    <thingToSpawn>N_Carts_Medium</thingToSpawn>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </Vehicles.VehicleBuildDef>

