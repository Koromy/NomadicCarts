    <vehicleStats>
      <Mass>125</Mass>
      <MoveSpeed>3</MoveSpeed>
      <CargoCapacity>300</CargoCapacity>
      <RepairRate>1.5</RepairRate>
      <MaximumPayload>0</MaximumPayload>
