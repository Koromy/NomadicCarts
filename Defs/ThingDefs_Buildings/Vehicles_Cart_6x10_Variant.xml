      </customHillinessCosts>
      <manhunterTargetsVehicle>false</manhunterTargetsVehicle>
      <roles>
        <li>
          <key>Wagoner</key>
          <label>Wagoner</label>
          <handlingTypes>Movement</handlingTypes>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <exposed>true</exposed>
          <hitbox>
            <cells>
              <li>(2,9)</li>
            </cells>
          </hitbox>
          <pawnRenderer>
            <drawOffsetNorth>(-1.5,0,6.5)</drawOffsetNorth>
            <drawOffsetSouth>(1.5,0,-4.5)</drawOffsetSouth>
            <drawOffsetEast>(6,0,2.25)</drawOffsetEast>
            <drawOffsetWest>(-6,0,-0.75)</drawOffsetWest>
